        <mxCell id="box_assess" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=10;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" value="&lt;b&gt;Assess — POC, выбор стека&lt;/b&gt;&lt;hr/&gt;• Сужение Apache Camel → API GW + события&lt;br/&gt;• MLOps (реестры моделей)&lt;br/&gt;• Feature Store" vertex="1">
          <mxGeometry height="100" width="320" x="880" y="440" as="geometry" />
        </mxCell>
        <mxCell id="box_hold" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=10;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" value="&lt;b&gt;Hold — не расширять&lt;/b&gt;&lt;hr/&gt;• Новая логика в SQL Server 2008 DWH&lt;br/&gt;• Тяжёлый ad-hoc BI → монолитный DWH&lt;br/&gt;• PowerBuilder как долгосрочная стратегия UI" vertex="1">
